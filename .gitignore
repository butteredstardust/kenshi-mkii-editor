node_modules/
webapp/.cache/
webapp/config/settings.json
.temp/
*.log

# The test fixture: a full snapshot of one of the player's saves (~39 MB), made
# by `npm run fixture:create`. The suite reads this instead of the live save.
webapp/.fixtures/

# Never commit save data or game data
*.save
*.platoon
*.zone
*.mod
*.base

# Playwright MCP scratch output from UI verification runs.
.playwright-mcp/

# Installer build output. build.ps1 stages a full copy of the app (node_modules
# and a bundled node.exe included) and Inno Setup writes the setup .exe and the
# generated .iss beside it.
releases/build/
releases/*.exe
releases/*.iss
