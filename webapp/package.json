{
  "name": "kenshi-mkii-editor",
  "version": "0.4.0",
  "description": "Kenshi MKII Editor — read/write editor for Kenshi save directories",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gamedata:rebuild": "node -e \"console.log(require('./services/gamedataService').rebuild().size, 'stringIDs indexed')\"",
    "status": "node scripts/status.js",
    "fixture:create": "node scripts/make-fixture.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  }
}
